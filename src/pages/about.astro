---
import Base from '../layouts/Base.astro';
import Introduction from '../components/Introduction.astro';
import { site, introductionText } from '../config/site';
---
<Base title="About" description={introductionText}>
  <div class="container page-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>About</span></nav>
    <div class="about-grid">
      <section class="about-main">
        <h1 class="page-title">About</h1>
        <h2 class="about-name">{site.name}</h2>
        <p class="about-tagline">{site.tagline}</p>
        <Introduction />
        {site.aboutSections.map((section) => (
          <section class="about-section" aria-labelledby={section.id}>
            <h2 id={section.id}>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}
      </section>
      <aside class="sidebar">
        <section>
          <h2>Get in touch</h2>
          <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
          {site.socialLinks.length > 0 && <ul class="profile-links">
            {site.socialLinks.map((link) => <li>
              <a class="profile-link" href={link.href} target="_blank" rel="noopener noreferrer">
                <span><span class="profile-label">{link.label}</span><span class="profile-handle">{link.handle}</span></span>
                <span class="profile-arrow" aria-hidden="true">↗</span>
                <span class="sr-only">（在新标签页打开）</span>
              </a>
            </li>)}
          </ul>}
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .about-section { max-width: 680px; margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--line); }
  .about-section h2 { font-size: 24px; letter-spacing: -.025em; margin-bottom: 16px; }
  .about-section p { color: var(--body); font-size: 16px; line-height: 1.9; }
  .about-section p + p { margin-top: 14px; }
  .sidebar .profile-links { display: block; margin-top: 20px; }
  .profile-link { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 6px; }
  .profile-label { display: block; color: var(--blue); font-size: 16px; }
  .profile-handle { display: block; color: var(--muted); font-size: 14px; margin-top: 3px; overflow-wrap: anywhere; }
  .profile-arrow { color: var(--blue); font-size: 20px; }
  .profile-link:hover .profile-label { text-decoration: underline; text-underline-offset: 5px; }
</style>
