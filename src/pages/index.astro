---
import Base from '../layouts/Base.astro';
import Geometry from '../components/Geometry.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../config/site';
import { sections } from '../config/sections';
---
<Base title={site.name} description={site.homeIntroduction} wide>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <p class="introduction">{site.homeIntroduction}</p>
      <a class="button" href="#journey">Explore My Journey <Arrow /></a>
    </div>
    <Geometry />
  </section>
  <section id="journey" class="journey" aria-label="Explore Study, Coding and Tools" tabindex="-1">
    <div class="container section-grid">
      {Object.entries(sections).map(([key, section], index) => (
        <article class="section-preview">
          <span class="section-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h2>{section.title}</h2>
          {site.showSectionImages && section.image && (
            <img src={section.image.src} srcset={`${section.image.src.replace('.webp', '-480.webp')} 480w, ${section.image.src} 960w`} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1100px) 30vw, 440px" width="960" height="440" alt={section.image.alt} loading="lazy" decoding="async" />
          )}
          <p>{section.description}</p>
          <a class="text-link" href={`/${key}/`}>Explore {section.title} <Arrow /></a>
        </article>
      ))}
    </div>
  </section>
</Base>
